git:
  # The background fetch runs every 60s and authenticates to GitHub with the
  # YubiKey-backed ~/.ssh/id_ed25519_sk, so it interrupts with a PIN prompt at
  # random moments. Fetch on demand with `f` instead.
  autoFetch: false
  diffRenderers:
    - # Same renderer as the git CLI and diffnav, so a diff looks identical
      # wherever you read it. --paging=never because lazygit does its own.
      colorArg: always
      command: delta --dark --paging=never --line-numbers --hyperlinks
gui:
  # The active theme's palette, same as wezterm/nvim/tuicr. The default theme
  # paints the selected line on ANSI blue (<<syn.fun>> here), which swallows the
  # filename and its status letters -- the role below is the terminal's own
  # selection background.
  theme:
    activeBorderColor: ["<<syn.type>>"]
    inactiveBorderColor: ["<<ui.bg_visual>>"]
    searchingActiveBorderColor: ["<<term.11>>"] # bright yellow
    optionsTextColor: ["<<term.12>>"]           # bright blue
    selectedLineBgColor: ["<<note.title_bg>>"]
    inactiveViewSelectedLineBgColor: ["<<note.bg>>"]
    # Dark text on a light chip -- the pair the defaults get wrong.
    cherryPickedCommitFgColor: ["<<term.0>>"]
    cherryPickedCommitBgColor: ["<<term.14>>"]  # bright cyan
    markedBaseCommitFgColor: ["<<term.0>>"]
    markedBaseCommitBgColor: ["<<term.11>>"]
    unstagedChangesColor: ["<<term.9>>"]       # bright red
    defaultFgColor: ["<<term.15>>"]
customCommands:
  - key: "C"
    command: "czg"
    description: "commit with commitizen"
    context: "files"
    loadingText: "opening commitizen commit tool"
    output: terminal
