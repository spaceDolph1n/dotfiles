#!/usr/bin/env python3
"""
vault-index -- regenerate the vault's machine-facing indexes.

    vault-index            write both indexes
    vault-index --check    exit 1 if either is out of date (no writes)

TWO indexes, split at the git line, and that split is the whole point:

    index.md        the pushed half (00 - zettelkasten, 0 - inbox) -- COMMITTED
    work/index.md   work/ only -- never committed, excluded with work/ itself

An index that names a work/ file must never reach GitHub. That is enforced
here, in code, rather than left to discipline: writing the root index aborts
if a work/ or learning/ path ever appears in it.

These are catalogues, not maps of content. They are generated, never
hand-edited, and safe to delete -- a hub note is the human artefact and is
written by hand. Following OKF, index.md is a reserved filename and carries no
frontmatter except the bundle-root okf_version.
"""

import os
import re
import sys

VAULT = os.environ.get("BRAIN_VAULT", os.path.expanduser("~/.sb/second-brain"))
SKIP_DIRS = {".git", ".obsidian", "files", "node_modules"}
OKF_VERSION = "0.2"
SHARD_WARN_LINES = 300

PUSHED = ("00 - zettelkasten", "0 - inbox")
LOCAL = ("work",)

# Order types deliberately: what you reach for most, first.
TYPE_ORDER = ["concept", "claim", "source", "reference", "bet", "ticket",
              "ticket-candidate", "people", "queue", "inbox"]

BANNED_IN_PUSHED = ("work/", "work\\", "learning/", "learning\\")


def parse_fm(text):
    if not text.startswith("---\n"):
        return {}
    end = text.find("\n---", 3)
    if end == -1:
        return {}
    fm, key = {}, None
    for raw in text[4:end].split("\n"):
        if not raw.strip():
            continue
        if re.match(r"^\s+-\s", raw) and key:
            # A bare `aliases:` sets "" first; the items that follow turn it
            # into the list it always was.
            if not isinstance(fm.get(key), list):
                fm[key] = []
            fm[key].append(raw.strip()[1:].strip().strip("\"'"))
            continue
        m = re.match(r"^([A-Za-z_][\w-]*):\s*(.*)$", raw)
        if not m:
            continue
        key, val = m.group(1), m.group(2).strip()
        fm[key] = [] if val == "[]" else val.strip("\"'")
    return fm


def collect(folders):
    out = []
    for folder in folders:
        base = os.path.join(VAULT, folder)
        if not os.path.isdir(base):
            continue
        for root, dirs, files in os.walk(base):
            dirs[:] = [d for d in dirs if d not in SKIP_DIRS]
            for fn in sorted(files):
                if not fn.endswith(".md") or fn == "index.md":
                    continue
                path = os.path.join(root, fn)
                text = open(path, encoding="utf-8", errors="replace").read()
                fm = parse_fm(text)
                out.append({
                    "rel": os.path.relpath(path, VAULT),
                    "id": fm.get("id") or fn[:-3],
                    "type": fm.get("type") or "untyped",
                    "tags": fm.get("tags") if isinstance(fm.get("tags"), list) else [],
                    "aliases": fm.get("aliases") if isinstance(fm.get("aliases"), list) else [],
                    "status": fm.get("status") or "",
                })
    return out


def render(notes, title, blurb, root_bundle):
    by_type = {}
    for n in notes:
        by_type.setdefault(n["type"], []).append(n)

    lines = []
    if root_bundle:
        lines += ["---", f'okf_version: "{OKF_VERSION}"', "---", ""]
    lines += [
        f"# {title}",
        "",
        blurb,
        "",
        f"{len(notes)} notes · regenerate with `vault-index` · **do not hand-edit**",
        "",
    ]

    ordered = [t for t in TYPE_ORDER if t in by_type] + \
              sorted(t for t in by_type if t not in TYPE_ORDER)
    for t in ordered:
        rows = sorted(by_type[t], key=lambda n: n["id"].lower())
        lines.append(f"## {t}  ({len(rows)})")
        lines.append("")
        for n in rows:
            # Aliases are "how I would search for it" -- the best summary already
            # in the vault. Tags come second, and only the first three.
            hint = ", ".join(n["aliases"][:3])
            tags = " ".join(f"#{t}" for t in n["tags"][:3])
            flag = f" **{n['status']}**" if n["status"] and n["status"] != "stable" else ""
            suffix = f" — {hint}" if hint else ""
            lines.append(f"- [[{n['id']}]]{flag}{suffix}  {tags}".rstrip())
        lines.append("")
    return "\n".join(lines).rstrip() + "\n"


def main():
    check = "--check" in sys.argv
    stale = False

    targets = [
        (os.path.join(VAULT, "index.md"), PUSHED, True,
         "Index — pushed half",
         "Machine-facing catalogue of the half of the vault that is in git.\n"
         "`work/` is deliberately absent: it is excluded from this repo and has "
         "its own index at `work/index.md`, which is never committed."),
        (os.path.join(VAULT, "work", "index.md"), LOCAL, False,
         "Index — work/ (local only)",
         "Never committed. Excluded alongside `work/` itself, and the pre-commit "
         "hook fails if it is ever staged."),
    ]

    for path, folders, is_root, title, blurb in targets:
        if not os.path.isdir(os.path.dirname(path)):
            continue
        notes = collect(folders)
        body = render(notes, title, blurb, root_bundle=is_root)

        if is_root:
            # Check the DATA, not the prose -- the blurb legitimately names work/
            # while explaining why nothing from it is listed.
            leaked = [n["rel"] for n in notes
                      if any(n["rel"].startswith(b) for b in BANNED_IN_PUSHED)]
            if leaked:
                print(f"ABORT: pushed index would list {len(leaked)} local-only "
                      f"note(s), first: {leaked[0]}. Refusing to write.", file=sys.stderr)
                return 2

        current = open(path, encoding="utf-8").read() if os.path.exists(path) else None
        n_lines = body.count("\n")
        label = os.path.relpath(path, VAULT)
        if current == body:
            print(f"  up to date   {label}  ({len(notes)} notes, {n_lines} lines)")
            continue
        stale = True
        if check:
            print(f"  STALE        {label}")
            continue
        open(path, "w", encoding="utf-8").write(body)
        print(f"  wrote        {label}  ({len(notes)} notes, {n_lines} lines)")
        if n_lines > SHARD_WARN_LINES:
            print(f"    ^ over {SHARD_WARN_LINES} lines — time to shard this by type "
                  f"into indexes/")

    if check and stale:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
