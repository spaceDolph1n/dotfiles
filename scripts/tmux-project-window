#!/usr/bin/env bash
#
# Pick a project and open it as a WINDOW in the current tmux session.
#
# This is the window-oriented counterpart to sesh: sesh switches between
# *sessions*, whereas this keeps one session and gives each project its own
# numbered window -- dotfiles #1, web #2, and so on.
#
# If a window for that project already exists it is selected rather than
# duplicated, so pressing the key repeatedly is idempotent.
#
# Projects declared in sesh.toml contribute both their path AND their
# `startup_command`, so `prefix + O` and `prefix + o` land you in the same
# layout -- the difference is only window vs session. Paths that come from
# zoxide just open a shell.
#
# Bound to `prefix + O` (see tmux.conf), run inside a popup so fzf has a real
# terminal.

set -euo pipefail

SESH_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/sesh/sesh.toml"

# Emit "path<TAB>startup_command" for each [[session]] in sesh.toml.
# Comment lines are skipped, so the commented examples never leak in.
sesh_entries() {
	[[ -f "$SESH_CONFIG" ]] || return 0
	awk '
		/^[[:space:]]*#/ { next }
		/^[[:space:]]*\[\[/ {
			if (path != "") print path "\t" cmd
			path = ""; cmd = ""; next
		}
		/^[[:space:]]*path[[:space:]]*=/ {
			if (match($0, /"[^"]*"/)) path = substr($0, RSTART+1, RLENGTH-2)
			next
		}
		/^[[:space:]]*startup_command[[:space:]]*=/ {
			if (match($0, /"[^"]*"/)) cmd = substr($0, RSTART+1, RLENGTH-2)
			next
		}
		END { if (path != "") print path "\t" cmd }
	' "$SESH_CONFIG"
}

# Candidate list: curated sesh paths first, then zoxide history.
list_candidates() {
	sesh_entries | cut -f1
	zoxide query -l 2>/dev/null || true
}

selected=$(
	list_candidates |
		sed "s|^~|$HOME|" |
		awk '!seen[$0]++' |
		fzf --prompt='  window  ' \
			--border-label=' project → new window ' \
			--height=100% --reverse \
			--preview 'eza --tree --level=1 --icons --git --no-user --color=always {} 2>/dev/null || ls -la {}' \
			--preview-window=right:55%
) || exit 0

[[ -n "$selected" && -d "$selected" ]] || exit 0

name=$(basename "$selected")

# Reuse an existing window for this project instead of opening a second one.
if tmux list-windows -F '#W' | grep -qxF "$name"; then
	tmux select-window -t "$name"
	exit 0
fi

# Look up a startup command for this exact path, if sesh.toml declares one.
startup=$(sesh_entries | sed "s|^~|$HOME|" | awk -F'\t' -v p="$selected" '$1 == p { print $2; exit }')

tmux new-window -c "$selected" -n "$name"
if [[ -n "$startup" ]]; then
	# send-keys rather than passing the command to new-window, so quitting the
	# editor leaves you in a shell instead of closing the window.
	tmux send-keys -t "$name" "$startup" C-m
fi
