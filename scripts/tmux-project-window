#!/usr/bin/env bash
#
# Pick anywhere worth being and open it as a WINDOW in this tmux session: a
# curated project (tmux/projects.toml), a workmux worktree, or a directory zoxide
# remembers. Bound to `prefix + O`, inside a popup so fzf has a real terminal.
#
# Every target opens the way a workmux worktree does -- shell on the left, agent
# on the right and focused -- so a window looks the same whichever list it came
# from. Worktrees go through `workmux open`, which also wires their status hooks;
# everything else gets the same split built here. An existing window is selected
# rather than duplicated, so pressing the key again is idempotent.

set -euo pipefail

PROJECTS="${XDG_CONFIG_HOME:-$HOME/.config}/tmux/projects.toml"
WORKTREE_ROOT="${WORKMUX_WORKTREE_ROOT:-$HOME/.worktrees}"
WORKMUX_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/workmux/config.yaml"

# Read the agent out of workmux's own config, so this split cannot start a
# different agent than `workmux open` would.
agent_command() {
	local agent
	agent=$(sed -n 's/^agent:[[:space:]]*//p' "$WORKMUX_CONFIG" 2>/dev/null | head -1)
	printf '%s' "${agent:-claude}"
}

# "path<TAB>name" for each [[project]]. Comment lines are skipped.
projects() {
	[[ -f "$PROJECTS" ]] || return 0
	awk '
		/^[[:space:]]*#/ { next }
		/^[[:space:]]*\[\[/ { if (path != "") print path "\t" name; path = ""; name = ""; next }
		/^[[:space:]]*path[[:space:]]*=/ { if (match($0, /"[^"]*"/)) path = substr($0, RSTART+1, RLENGTH-2); next }
		/^[[:space:]]*name[[:space:]]*=/ { if (match($0, /"[^"]*"/)) name = substr($0, RSTART+1, RLENGTH-2); next }
		END { if (path != "") print path "\t" name }
	' "$PROJECTS" | sed "s|^~|$HOME|"
}

# "label<TAB>path<TAB>window name". One icon column for all three sources, so no
# row reads as a child of another. Order matters: the dedupe below keeps the
# first row per path, and zoxide knows some projects and worktrees already.
list_candidates() {
	projects | awk -F'\t' '{ print " " $2 "\t" $1 "\t" $2 }'
	local dir project
	for dir in "$WORKTREE_ROOT"/*/*/; do
		[[ -d "$dir" ]] || continue
		dir="${dir%/}"
		project="${dir%/*}"
		# The handle alone repeats across projects, so the project leads.
		printf ' %s / %s\t%s\t%s\n' "${project##*/}" "${dir##*/}" "$dir" "${dir##*/}"
	done
	# Last two segments, not the basename: zoxide is full of `git` and `plugins`,
	# and two rows reading `git` cannot be told apart.
	zoxide query -l 2>/dev/null | awk '{
		n = split($0, parts, "/")
		label = n > 1 ? parts[n-1] "/" parts[n] : parts[n]
		print " " label "\t" $0 "\t" parts[n]
	}' || true
}

picked=$(
	list_candidates |
		awk -F'\t' '!seen[$2]++' |
		fzf --prompt='  window  ' \
			--border-label=' project, worktree or directory → window ' \
			--height=100% --reverse \
			--delimiter='\t' --with-nth=1 --accept-nth=2,3 \
			--preview "case {2} in
			             $WORKTREE_ROOT/*)
			               git -C {2} log --oneline --decorate -12 --color=always 2>/dev/null
			               echo; git -C {2} status -s 2>/dev/null | head -20 ;;
			             *)
			               eza --tree --level=1 --icons --git --no-user --color=always {2} 2>/dev/null || ls -la {2} ;;
			           esac" \
			--preview-window=right:55%
) || exit 0

selected=${picked%%$'\t'*}
name=${picked#*$'\t'}
[[ -n "$selected" && -d "$selected" ]] || exit 0

# Worktrees: `workmux open` gives the window its layout and status hooks. It is
# repo-scoped with no `project:handle` form, so run it from inside the worktree.
# --parent-session because a popup has no TMUX_PANE, so workmux cannot choose
# between live sessions itself.
if [[ "$selected" == "$WORKTREE_ROOT"/* ]]; then
	cd "$selected"
	parent_args=()
	parent=$(tmux display-message -p '#{session_name}' 2>/dev/null || true)
	[[ -n "$parent" ]] && parent_args=(--parent-session "$parent")
	if ! err=$(workmux open "$name" "${parent_args[@]}" 2>&1 >/dev/null); then
		tmux display-message "tmux-project-window: ${err:-workmux open $name failed}"
	fi
	exit 0
fi

if tmux list-windows -F '#W' | grep -qxF "$name"; then
	tmux select-window -t "=$name"
	exit 0
fi

# The workmux shape: shell left, agent split off to the right and focused, which
# is where split-window leaves the cursor. The agent registers itself for status
# tracking through the hook in ~/.claude, so it still shows in the sidebar.
pane=$(tmux new-window -P -F '#{pane_id}' -c "$selected" -n "$name")
tmux split-window -h -t "$pane" -c "$selected" "$(agent_command)"
