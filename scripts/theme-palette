#!/usr/bin/env python3
"""Emit one theme's palette as flat, role-keyed JSON on stdout.

    theme-palette kanso
    theme-palette kanagawa-dragon

The palette is never transcribed: it is read out of the nvim plugin already on
disk, so this and nvim can't disagree. `term` is the exception -- it comes from
each theme's own upstream wezterm extra, because a theme's `theme.term` and its
wezterm port disagree (kanso's differ on ansi-cyan and bright-black, and
wezterm.lua already follows the port).
"""

import json
import os
import re
import subprocess
import sys

LAZY = os.path.expanduser("~/.local/share/nvim/lazy")

# rose-pine names colours, not roles, so the roles kanagawa states directly have
# to be assembled. Every line is rose-pine's own highlight for that role
# (lua/rose-pine.lua) or its semantic group (lua/rose-pine/config.lua) -- read
# off the plugin, not chosen here, so nvim and the generated surfaces agree.
#
# A tuple is a blend, which is how rose-pine draws its diff rows: `blend = 20`
# over the background. A config file needs the literal that produces.
ROSE_PINE = {
    "diag.error": "love",
    "diag.hint": "iris",
    "diag.info": "foam",
    "diag.ok": "leaf",
    "diag.warning": "gold",

    "diff.add": ("mix", "base", "foam", 0.20),
    "diff.change": ("mix", "base", "rose", 0.20),
    "diff.delete": ("mix", "base", "love", 0.20),
    "diff.text": ("mix", "base", "rose", 0.40),

    "syn.comment": "subtle",
    "syn.constant": "gold",
    "syn.deprecated": "muted",
    "syn.fun": "rose",
    "syn.identifier": "text",
    "syn.keyword": "pine",
    "syn.number": "gold",
    "syn.operator": "subtle",
    "syn.parameter": "text",
    "syn.preproc": "iris",
    "syn.punct": "subtle",
    "syn.regex": "rose",
    "syn.special1": "foam",
    "syn.special2": "rose",
    "syn.special3": "iris",
    "syn.statement": "pine",
    "syn.string": "gold",
    "syn.type": "foam",

    # rose-pine stacks exactly three surfaces: base, surface (floats and panels),
    # overlay (the cursor line). There is nothing below base -- and with base at
    # near-black there is no room for one -- so the darker steps are base itself.
    # No template references them; inventing a colour to fill them would be worse
    # than saying so.
    "ui.bg": "base",
    "ui.bg_dim": "base",
    "ui.bg_m1": "base",
    "ui.bg_m2": "base",
    "ui.bg_m3": "base",
    "ui.bg_p1": "surface",
    "ui.bg_p2": "overlay",
    "ui.bg_search": ("mix", "base", "gold", 0.20),
    # highlight_med, not an iris blend: this is what the kitty port uses for
    # `selection_background`, and a terminal selection has to match the terminal.
    "ui.bg_visual": "highlight_med",
    "ui.fg": "text",
    "ui.fg_dim": "subtle",
    "ui.fg_reverse": "base",
    "ui.float.bg": "surface",
    "ui.float.bg_border": "surface",
    "ui.float.fg": "text",
    "ui.float.fg_border": "muted",
    "ui.nontext": "muted",
    "ui.special": "foam",
    "ui.whitespace": "muted",
    "ui.pmenu.bg": "surface",
    "ui.pmenu.bg_sbar": "surface",
    "ui.pmenu.bg_sel": "overlay",
    "ui.pmenu.bg_thumb": "muted",
    "ui.pmenu.fg": "subtle",

    "vcs.added": "foam",
    "vcs.changed": "rose",
    "vcs.removed": "love",
    "vcs.untracked": "subtle",
}

# `expr` is the Lua that yields the theme's colour table in a clean nvim. Two
# shapes exist: kanagawa derivatives return a nested `theme` tree already keyed
# by role, and rose-pine returns one flat table of 19 named colours. A theme with
# `roles` is the flat kind and gets assembled below; without it, the tree already
# is the palette.
THEMES = {
    "kanso": {
        "plugin": "kanso.nvim",
        "expr": "require('kanso.colors').setup({theme='zen'}).theme",
        "wezterm": "extras/wezterm/kanso-zen.lua",
    },
    "kanagawa-dragon": {
        "plugin": "kanagawa.nvim",
        "expr": "require('kanagawa.colors').setup({theme='dragon'}).theme",
        "wezterm": "extras/wezterm/kanagawa-dragon.lua",
    },
    "rose-pine": {
        "plugin": "rose-pine",
        "expr": "require('rose-pine.palette')",
        "roles": ROSE_PINE,
        # The one colour that is not upstream's. rose-pine's own base is #191724,
        # a washed plum; this variant is the near-black one. nvim applies the
        # same override in its `setup()` call, and that pair is the only place
        # the editor and the generated surfaces could disagree.
        "overrides": {"base": "#090b10"},
        # rose-pine/neovim ships no `extras/` directory, so the 16 slots come
        # from the upstream rose-pine/kitty port instead -- the same role the
        # wezterm extra plays for the other two. Normal and bright are identical
        # above slot 8 except for black, which is upstream's choice, not a
        # transcription slip.
        "term": [
            "#26233a", "#eb6f92", "#31748f", "#f6c177",
            "#9ccfd8", "#c4a7e7", "#ebbcba", "#e0def4",
            "#6e6a86", "#eb6f92", "#31748f", "#f6c177",
            "#9ccfd8", "#c4a7e7", "#ebbcba", "#e0def4",
        ],
    },
}


# The contract: roles BOTH themes emit. kanso ships 82 and dragon 75, so
# anything outside this intersection has to be derived below or it breaks the
# moment you switch.
ROLES = [
    "diag.error", "diag.hint", "diag.info", "diag.ok", "diag.warning",
    "diff.add", "diff.change", "diff.delete", "diff.text",
    "syn.comment", "syn.constant", "syn.deprecated", "syn.fun",
    "syn.identifier", "syn.keyword", "syn.number", "syn.operator",
    "syn.parameter", "syn.preproc", "syn.punct", "syn.regex",
    "syn.special1", "syn.special2", "syn.special3", "syn.statement",
    "syn.string", "syn.type",
    "ui.bg", "ui.bg_dim", "ui.bg_m1", "ui.bg_m2", "ui.bg_m3",
    "ui.bg_p1", "ui.bg_p2", "ui.bg_search", "ui.bg_visual",
    "ui.fg", "ui.fg_dim", "ui.fg_reverse",
    "ui.float.bg", "ui.float.bg_border", "ui.float.fg", "ui.float.fg_border",
    "ui.nontext", "ui.special", "ui.whitespace",
    "ui.pmenu.bg", "ui.pmenu.bg_sbar", "ui.pmenu.bg_sel", "ui.pmenu.bg_thumb",
    "ui.pmenu.fg",
    "vcs.added", "vcs.changed", "vcs.removed",
]

# `syn.variable` and `ui.pmenu.fg_sel` are absent on purpose: both themes put an
# "inherit" sentinel there and disagree on its case. Validate on "starts with #".

# Roles one theme has and the other does not, aliased onto a shared role. The
# semantics, not the look, decide the alias -- untracked files are non-content,
# which is what nontext means.
ALIASES = {
    "vcs.untracked": "ui.nontext",
    "ui.cursor_fg": "ui.bg",
    "ui.cursor_bg": "ui.fg",
    "ui.indent_line": "ui.whitespace",
    "ui.active_indent_line": "ui.bg_p2",
}

# Colours no theme states. The *_content_bg pair is a row tint lifted a third of
# the way toward the git sign colour -- exactly a third, not 0.33, which is what
# reproduces the values hand-tuned in hunk/config.toml.
DERIVED = {
    "diff.add_content": ("mix", "diff.add", "vcs.added", 1 / 3),
    "diff.delete_content": ("mix", "diff.delete", "vcs.removed", 1 / 3),
    "note.bg": ("alias", "ui.bg_p1"),
    "note.title_bg": ("alias", "ui.bg_p2"),
    # Violet is the one hue neither theme spends on diff or git state, so a note
    # never reads as a change.
    "note.border": ("alias", "syn.keyword"),
    # `ui.bg_dim` cannot serve: kanso's is lighter than its bg, dragon's darker.
    # 0.175 is the weight that reproduces the #0d1218 already in tmux.conf.
    "ui.bg_inactive": ("mix", "ui.bg", "ui.bg_p2", 0.175),
    # One surface step above bg_p2, for panel borders. Neither theme states it,
    # and `ui.bg_visual` cannot stand in: kanso's is grey but dragon's is blue
    # (#223249), which would paint hunk's borders the wrong hue entirely.
    "ui.border": ("mix", "ui.bg_p2", "ui.fg_dim", 0.2),
}


def die(message):
    sys.stderr.write(f"theme-palette: {message}\n")
    raise SystemExit(1)


def flatten(table, prefix=""):
    flat = {}
    for key, value in table.items():
        if isinstance(value, dict):
            flat.update(flatten(value, f"{prefix}{key}."))
        else:
            flat[f"{prefix}{key}"] = value
    return flat


def nvim_palette(spec):
    """Evaluate the theme's Lua in a clean nvim and dump the table it yields."""
    lua_root = os.path.join(LAZY, spec["plugin"], "lua")
    if not os.path.isdir(lua_root):
        die(f"{spec['plugin']} is not installed under {LAZY}")
    script = (
        f"lua package.path=package.path..';{lua_root}/?.lua;{lua_root}/?/init.lua';"
        f"local p={spec['expr']};"
        "io.stdout:write(vim.json.encode(p))"
    )
    result = subprocess.run(
        ["nvim", "--headless", "--clean", "-c", script, "-c", "qa!"],
        capture_output=True, text=True,
    )
    try:
        return flatten(json.loads(result.stdout))
    except (json.JSONDecodeError, ValueError):
        die(f"could not evaluate `{spec['expr']}`: {result.stderr.strip()[:200]}")


def assemble(raw, roles, name):
    """Turn a flat table of named colours into the role table the contract wants."""
    resolved = {}
    for role, recipe in roles.items():
        if isinstance(recipe, str):
            colour = raw.get(recipe)
            if not isinstance(colour, str) or not colour.startswith("#"):
                die(f"{name} has no colour named `{recipe}` for `{role}`")
            resolved[role] = colour
        else:
            _, first, second, weight = recipe
            resolved[role] = mix(raw[first], raw[second], weight)
    return resolved


def wezterm_term(spec):
    """The 16 ANSI slots from the theme's own wezterm extra: ansi then brights."""
    path = os.path.join(LAZY, spec["plugin"], spec["wezterm"])
    try:
        with open(path) as handle:
            source = handle.read()
    except OSError:
        die(f"no wezterm extra at {path}")

    slots = []
    for group in ("ansi", "brights"):
        match = re.search(rf"\b{group}\s*=\s*\{{(.*?)\}}", source, re.DOTALL)
        if not match:
            die(f"no `{group}` table in {path}")
        found = re.findall(r'"(#[0-9a-fA-F]{6})"', match.group(1))
        if len(found) != 8:
            die(f"`{group}` in {path} has {len(found)} colours, expected 8")
        slots.extend(found)
    return {f"term.{index}": value for index, value in enumerate(slots)}


def mix(a, b, weight):
    """Blend two hex colours; weight is how far to move from a toward b."""
    pair = [tuple(int(h.lstrip("#")[i:i + 2], 16) for i in (0, 2, 4)) for h in (a, b)]
    blended = (round(x + (y - x) * weight) for x, y in zip(*pair))
    return "#" + "".join(f"{channel:02X}" for channel in blended)


def build(name):
    spec = THEMES[name]
    raw = nvim_palette(spec)
    raw.update(spec.get("overrides", {}))
    if "roles" in spec:
        raw = assemble(raw, spec["roles"], name)

    palette = {}
    for role in ROLES:
        value = raw.get(role)
        if not isinstance(value, str) or not value.startswith("#"):
            die(f"{name} has no colour for `{role}` (got {value!r})")
        palette[role] = value

    for role, source in ALIASES.items():
        value = raw.get(role)
        palette[role] = value if isinstance(value, str) and value.startswith("#") else palette[source]

    for role, recipe in DERIVED.items():
        if recipe[0] == "alias":
            palette[role] = palette[recipe[1]]
        else:
            palette[role] = mix(palette[recipe[1]], palette[recipe[2]], recipe[3])

    # A theme with its own wezterm extra is read from it; one without states the
    # 16 slots in its spec instead.
    palette.update({f"term.{i}": v for i, v in enumerate(spec["term"])}
                   if "term" in spec else wezterm_term(spec))
    # Upstream mixes cases within one palette (kanso has #C5C9C7 next to
    # #c4746e), so normalise -- otherwise generated output is inconsistent and
    # byte-comparison against it is noise.
    return {role: value.lower() for role, value in palette.items()}


def main(argv):
    if len(argv) != 2:
        die(f"usage: theme-palette <{'|'.join(THEMES)}>")
    if argv[1] not in THEMES:
        die(f"unknown theme {argv[1]!r}; known: {', '.join(THEMES)}")
    json.dump(build(argv[1]), sys.stdout, indent=2, sort_keys=True)
    sys.stdout.write("\n")


if __name__ == "__main__":
    main(sys.argv)
