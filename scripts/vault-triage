#!/usr/bin/env python3
"""Inbox mechanics for /triage, so no capture is ever lost.
  vault-triage list | count            the captures waiting, numbered
  vault-triage done <dest> "<line>"    receipt first, then remove that exact line
"""
import fcntl, os, sys
from datetime import datetime

VAULT = os.environ.get("BRAIN_VAULT", os.path.expanduser("~/.sb/second-brain"))
INBOX, DONE = os.path.join(VAULT, "captures.md"), os.path.join(VAULT, "captures-done.md")
LOCK = os.path.join(VAULT, ".captures.lock")  # shared with brain, which appends under lockf


def lines():
    return open(INBOX).read().splitlines() if os.path.exists(INBOX) else []


def done(dest, line):
    with open(LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        current = lines()  # re-read under the lock: captures typed since `list` stay
        if line not in current:
            sys.exit(f"vault-triage: not in the inbox: {line}")
        with open(DONE, "a") as receipt:
            receipt.write(f"- {datetime.now():%Y-%m-%d %H:%M} — {dest} — {line}\n")
            receipt.flush()
            os.fsync(receipt.fileno())
        current.remove(line)
        tmp = INBOX + ".tmp"
        with open(tmp, "w") as out:
            out.write("".join(f"{l}\n" for l in current))
        os.replace(tmp, INBOX)


cmd = sys.argv[1] if len(sys.argv) > 1 else ""
if cmd == "list":
    for n, l in enumerate(lines(), 1):
        print(f"{n}. {l}")
elif cmd == "count":
    print(len(lines()))
elif cmd == "done" and len(sys.argv) == 4:
    done(sys.argv[2], sys.argv[3])
else:
    sys.exit(__doc__.strip())
