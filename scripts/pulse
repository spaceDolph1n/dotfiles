#!/usr/bin/env python3
"""What people said about a topic recently, ranked by how much they engaged.

    pulse "claude code"              the last 30 days, every source that works
    pulse jev --days 7               a shorter window
    pulse "local llm" --source hn    one source
    pulse "agents" --json            for piping somewhere else

The gap this fills: a web search tells you what a handful of pages say. It
cannot tell you whether five people or five thousand agreed, which is the only
thing that separates a trend from one loud post. Every source here is ranked by
its own engagement signal.

Sources, and why these ones:

    hn        Hacker News via the Algolia API. Keyless, points and comment
              counts, and the highest-substance venue for tooling discussion.
    bluesky   The public AppView. Keyless, real like/repost/reply counts, and
              where a large part of the tech conversation moved -- but it
              rate-limits unauthenticated clients hard and will often 403. When
              it does, the run carries on without it and says so. A free app
              password would fix it properly.
    reddit    Needs a free OAuth app (see below). Reddit began 403-ing the
              public `.json` endpoints, its RSS carries no scores, and the
              arctic-shift archive snapshots posts before votes accumulate --
              so every keyless route gives titles with no ranking signal at
              all, which is worse than no Reddit.

X is absent on purpose. There is no keyless path left: the v2 API returns 401
without a paid bearer token, x.com/search serves an empty app shell, and the
public Nitter instances are gone. The only route is a logged-in session cookie,
which is a different kind of decision from anything above.

Reddit setup, one time, free:
    1. reddit.com/prefs/apps -> create app -> type "script"
    2. redirect uri can be http://localhost
    3. security add-generic-password -s pulse-reddit-id     -a "$USER" -w <client id>
       security add-generic-password -s pulse-reddit-secret -a "$USER" -w <secret>
"""

import argparse
import json
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

UA = "pulse/0.1 (personal research script)"
TIMEOUT = 15


def fetch(url, headers=None, data=None):
    """GET as JSON. One attempt, deliberately.

    Bluesky's public AppView rate-limits unauthenticated clients hard, and the
    budget is per-burst rather than per-minute. Measured here: six probes 45s
    apart gave 200, 403, 403, 200, 200, 403; then eighteen requests in thirty
    seconds, as three-attempt retries, gave eighteen 403s and left the next five
    spaced calls at one success in five.

    So retrying is not free politeness, it spends the budget that the next call
    needed. A 403 is reported and the source is skipped. An app password would
    lift the limit properly; a retry loop only lowers it.
    """
    request = urllib.request.Request(url, data=data, headers={"User-Agent": UA, **(headers or {})})
    with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
        return json.load(response)


def keychain(service):
    """A secret from the login keychain, or None. Never prompts non-interactively."""
    result = subprocess.run(
        ["security", "find-generic-password", "-w", "-s", service],
        capture_output=True, text=True,
    )
    return result.stdout.strip() or None if result.returncode == 0 else None


# --- sources -----------------------------------------------------------------
#
# Each returns a list of dicts: source, title, url, engagement, when, who.
# `engagement` is whatever that platform counts, and the numbers are NOT
# comparable across sources -- 500 HN points is not 500 Bluesky likes. They are
# normalised against the best result within their own source before merging.


def hacker_news(topic, since):
    query = urllib.parse.urlencode({
        "query": topic,
        "tags": "story",
        "numericFilters": f"created_at_i>{since}",
        "hitsPerPage": 50,
    })
    hits = fetch(f"https://hn.algolia.com/api/v1/search?{query}").get("hits", [])
    items = []
    for hit in hits:
        points = hit.get("points") or 0
        comments = hit.get("num_comments") or 0
        items.append({
            "source": "hn",
            "title": hit.get("title") or "",
            # A text post has no url of its own; the discussion is the artifact.
            "url": hit.get("url") or f"https://news.ycombinator.com/item?id={hit['objectID']}",
            "discussion": f"https://news.ycombinator.com/item?id={hit['objectID']}",
            "engagement": points + comments,
            "detail": f"{points} points, {comments} comments",
            "when": hit.get("created_at_i") or 0,
            "who": hit.get("author") or "",
        })
    return items


def bluesky(topic, since):
    # `public.api.bsky.app` 403s; `api.bsky.app` serves the same unauthenticated
    # AppView and does not. Worth keeping the working host written down.
    query = urllib.parse.urlencode({"q": topic, "limit": 100, "sort": "top"})
    posts = fetch(f"https://api.bsky.app/xrpc/app.bsky.feed.searchPosts?{query}").get("posts", [])
    items = []
    for post in posts:
        stamp = post.get("indexedAt", "")
        try:
            when = int(time.mktime(time.strptime(stamp[:19], "%Y-%m-%dT%H:%M:%S")))
        except ValueError:
            when = 0
        if when and when < since:
            continue
        likes = post.get("likeCount") or 0
        reposts = post.get("repostCount") or 0
        replies = post.get("replyCount") or 0
        handle = post["author"]["handle"]
        rkey = post["uri"].rsplit("/", 1)[-1]
        text = " ".join((post.get("record", {}).get("text") or "").split())
        items.append({
            "source": "bluesky",
            "title": text[:160],
            "url": f"https://bsky.app/profile/{handle}/post/{rkey}",
            "discussion": None,
            # A repost is a stronger signal than a like, a reply stronger still.
            "engagement": likes + reposts * 2 + replies * 2,
            "detail": f"{likes} likes, {reposts} reposts, {replies} replies",
            "when": when,
            "who": handle,
        })
    return items


def reddit(topic, since):
    client_id = keychain("pulse-reddit-id")
    secret = keychain("pulse-reddit-secret")
    if not (client_id and secret):
        raise RuntimeError("no credentials in the keychain; see the header of this file")

    body = urllib.parse.urlencode({"grant_type": "client_credentials"}).encode()
    auth = urllib.request.HTTPPasswordMgrWithDefaultRealm()
    auth.add_password(None, "https://www.reddit.com/api/v1/access_token", client_id, secret)
    opener = urllib.request.build_opener(urllib.request.HTTPBasicAuthHandler(auth))
    request = urllib.request.Request(
        "https://www.reddit.com/api/v1/access_token", data=body,
        headers={"User-Agent": UA},
    )
    with opener.open(request, timeout=TIMEOUT) as response:
        token = json.load(response)["access_token"]

    query = urllib.parse.urlencode({"q": topic, "sort": "top", "t": "month", "limit": 100})
    listing = fetch(
        f"https://oauth.reddit.com/search?{query}",
        headers={"Authorization": f"bearer {token}"},
    )
    items = []
    for child in listing.get("data", {}).get("children", []):
        post = child["data"]
        when = int(post.get("created_utc") or 0)
        if when and when < since:
            continue
        score = post.get("score") or 0
        comments = post.get("num_comments") or 0
        items.append({
            "source": "reddit",
            "title": post.get("title") or "",
            "url": post.get("url") or "",
            "discussion": "https://www.reddit.com" + post.get("permalink", ""),
            "engagement": score + comments,
            "detail": f"{score} points, {comments} comments in r/{post.get('subreddit')}",
            "when": when,
            "who": post.get("subreddit") or "",
        })
    return items


SOURCES = {"hn": hacker_news, "bluesky": bluesky, "reddit": reddit}


# --- ranking -----------------------------------------------------------------


def normalise_url(url):
    """Strip the noise that stops two links to the same page matching."""
    parts = urllib.parse.urlsplit(url or "")
    query = [
        (k, v) for k, v in urllib.parse.parse_qsl(parts.query)
        if not k.startswith(("utm_", "ref"))
    ]
    host = parts.netloc.lower().removeprefix("www.")
    return urllib.parse.urlunsplit(
        ("", host, parts.path.rstrip("/"), urllib.parse.urlencode(query), "")
    )


def rank(items):
    """Score each item against the best result from its own source.

    Raw counts cannot be compared across platforms, so each is divided by the
    top engagement within its own source. The best item per source ties at 1.0,
    which is honest: it says "this led its venue", not "this beat that one".
    """
    best = {}
    for item in items:
        best[item["source"]] = max(best.get(item["source"], 0), item["engagement"])
    for item in items:
        ceiling = best[item["source"]] or 1
        item["score"] = item["engagement"] / ceiling
    # Ties break on recency, not on raw engagement. Every source has an item at
    # 1.0 by construction, and breaking those on the raw number would put the
    # platform that counts in thousands above the one that counts in tens, every
    # single time -- which is the comparison the normalisation exists to refuse.
    return sorted(items, key=lambda i: (-i["score"], -i["when"]))


def dedupe(items):
    """One row per link. The copy with more engagement wins and keeps the rest."""
    seen = {}
    for item in items:
        key = normalise_url(item["url"]) or item["title"][:80].lower()
        if key not in seen or item["engagement"] > seen[key]["engagement"]:
            item = dict(item, also=seen[key]["source"] if key in seen else None)
            seen[key] = item
        elif seen[key]["source"] != item["source"]:
            seen[key]["also"] = item["source"]
    return list(seen.values())


# --- output ------------------------------------------------------------------

BOLD, DIM, CYAN, RESET = "\033[1m", "\033[90m", "\033[36m", "\033[0m"


def render(items, limit, colour):
    bold, dim, cyan, reset = (BOLD, DIM, CYAN, RESET) if colour else ("", "", "", "")
    now = time.time()
    for index, item in enumerate(items[:limit], 1):
        days = int((now - item["when"]) / 86400) if item["when"] else None
        age = f"{days}d ago" if days is not None else "undated"
        also = f" +{item['also']}" if item.get("also") else ""
        print(f"{bold}{index:2}. {item['title']}{reset}")
        print(f"    {cyan}{item['source']}{also}{reset} {dim}·{reset} {item['detail']} {dim}·{reset} {age}")
        print(f"    {dim}{item['url']}{reset}")
        if item.get("discussion") and item["discussion"] != item["url"]:
            print(f"    {dim}{item['discussion']}{reset}")
        print()


def main():
    parser = argparse.ArgumentParser(
        description="What people said about a topic recently, ranked by engagement.",
        epilog="Reddit needs a free OAuth app; see the header of this file.",
    )
    parser.add_argument("topic", help="what to search for; quote a phrase")
    parser.add_argument("--days", type=int, default=30, help="window in days (default 30)")
    parser.add_argument("--limit", type=int, default=20, help="rows to print (default 20)")
    parser.add_argument("--source", action="append", choices=sorted(SOURCES),
                        help="only this source; repeatable")
    parser.add_argument("--json", action="store_true", help="emit JSON instead of text")
    args = parser.parse_args()

    since = int(time.time() - args.days * 86400)
    wanted = args.source or list(SOURCES)

    items, failures = [], []
    for name in wanted:
        try:
            items.extend(SOURCES[name](args.topic, since))
        except (urllib.error.URLError, urllib.error.HTTPError, RuntimeError, KeyError) as error:
            # One dead source must not take the run with it -- the others still
            # answer the question, just less completely. Say so on stderr so a
            # pipe to --json stays clean.
            failures.append(f"{name}: {error}")

    if not items:
        print(f"nothing found for {args.topic!r} in the last {args.days} days", file=sys.stderr)
        for failure in failures:
            print(f"  {failure}", file=sys.stderr)
        return 1

    ranked = rank(dedupe(items))

    if args.json:
        json.dump(ranked[:args.limit], sys.stdout, indent=2)
        sys.stdout.write("\n")
    else:
        render(ranked, args.limit, sys.stdout.isatty())
        print(f"{DIM}{len(ranked)} results from {', '.join(sorted({i['source'] for i in ranked}))}"
              f", last {args.days} days{RESET}", file=sys.stderr)

    for failure in failures:
        print(f"skipped {failure}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
