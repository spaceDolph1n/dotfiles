#!/usr/bin/env bash
#
# Commit (and push) the second brain. Run by a LaunchAgent once a day.
#
# Deliberately separate from `brain`: capture writes files, this handles
# version control. Safe to run by hand at any time.
#
#   brain-commit            commit and push
#   brain-commit --no-push  commit only

set -euo pipefail

VAULT="${BRAIN_VAULT:-$HOME/.sb/second-brain}"
PUSH=1
[[ "${1:-}" == "--no-push" ]] && PUSH=0

# launchd gives a minimal environment: no .zshrc, so no PATH additions and no
# GIT_CONFIG_GLOBAL. Without the latter git never reads ~/.config/git/.gitconfig,
# the includeIf for ~/.sb/ never applies, and commits are authored as
# user@hostname. This is the same trap that mis-authored five Raycast captures.
export PATH="/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export GIT_CONFIG_GLOBAL="${GIT_CONFIG_GLOBAL:-$HOME/.config/git/.gitconfig}"

cd "$VAULT" || { echo "vault not found: $VAULT" >&2; exit 1; }

if [[ -z "$(git status --porcelain)" ]]; then
	echo "$(date '+%Y-%m-%d %H:%M') nothing to commit"
	exit 0
fi

files=$(git status --porcelain | wc -l | tr -d ' ')
git add -A
git commit --quiet -m "vault: daily snapshot ($files changed)"
echo "$(date '+%Y-%m-%d %H:%M') committed $files file(s)"

if [[ $PUSH -eq 1 ]]; then
	# Best effort. Being offline must not turn into a failed job.
	if git push --quiet origin HEAD 2>/dev/null; then
		echo "  pushed"
	else
		echo "  push failed (offline?) — will go with the next run"
	fi
fi
