#!/usr/bin/env bash
#
# Commit (and push) any uncommitted work in the repos worth not losing.
# Run by a LaunchAgent daily and at login. Safe to run by hand.
#
#   daily-snapshot            commit and push
#   daily-snapshot --no-push  commit only
#   daily-snapshot --plain    skip the generated message, use the file count
#
# Deliberately separate from `brain`: capture writes files, this handles
# version control.

set -euo pipefail

# Only these. Not a scan of the filesystem -- an auto-commit loose in a work
# repo is how you push something half-finished to a shared branch.
REPOS=(
	"$HOME/.sb/second-brain"
	"$HOME/.config/dotfiles"
)

PUSH=1
PLAIN=0
for arg in "$@"; do
	[[ "$arg" == "--no-push" ]] && PUSH=0
	[[ "$arg" == "--plain" ]] && PLAIN=1
done

# Only dotfiles gets a generated message: it sends the staged diff to the API,
# and second-brain holds personal notes. `work/` is gitignored there so employer
# material never reaches a diff, but that is not the same as consenting to send
# the rest. Add repos here deliberately.
MESSAGE_REPOS=("$HOME/.config/dotfiles")

MESSAGE_TIMEOUT=90
MESSAGE_PROMPT='Write a git commit message for these staged changes.
First line: conventional-commits (feat/fix/chore/refactor/docs), imperative, max 72 chars.
Then a blank line and 1-3 bullet lines stating what changed, factual only.
Describe only what the diff shows; never guess intent.
Never add Co-Authored-By or any attribution.'

# Ask Claude what changed. Every failure path falls back to the file count -- a
# safety net that can fail is not one.
generate_message() { # generate_message <repo> <dirty-count>
	local repo=$1 fallback="chore: snapshot of uncommitted work ($2 changed)"
	local wanted=0 candidate
	for candidate in "${MESSAGE_REPOS[@]}"; do
		[[ "$repo" == "$candidate" ]] && wanted=1
	done
	if [[ $PLAIN -eq 1 || $wanted -eq 0 ]] || ! command -v claude >/dev/null 2>&1; then
		printf '%s' "$fallback"
		return
	fi

	local raw pid guard msg
	raw=$(mktemp)
	{
		git -C "$repo" diff --cached --stat
		printf '\n'
		git -C "$repo" diff --cached | head -300
	} | claude -p --model haiku "$MESSAGE_PROMPT" >"$raw" 2>/dev/null &
	pid=$!
	( sleep "$MESSAGE_TIMEOUT"; kill -TERM "$pid" 2>/dev/null ) >/dev/null 2>&1 &
	guard=$!
	wait "$pid" 2>/dev/null || true
	kill "$guard" 2>/dev/null || true

	# The model wraps its answer in prose and code fences however firmly it is
	# told not to, so take the fenced block when present and otherwise skip to
	# the first conventional-commit line.
	msg=$(SNAPSHOT_RAW="$raw" python3 -c '
import os, re, sys
text = open(os.environ["SNAPSHOT_RAW"]).read()
fence = re.search(r"```[a-z]*\n(.*?)```", text, re.S)
lines = (fence.group(1) if fence else text).splitlines()
head = re.compile(r"^(feat|fix|chore|refactor|docs|style|test|perf|build|ci)(\(.+\))?: .")
start = next((i for i, l in enumerate(lines) if head.match(l)), None)
if start is None or len(lines[start]) > 72:
    sys.exit(1)
print("\n".join(lines[start:]).strip())
' 2>/dev/null) || msg=""
	rm -f "$raw"
	printf '%s' "${msg:-$fallback}"
}

# launchd gives a minimal environment: no .zshrc, so no PATH additions and no
# GIT_CONFIG_GLOBAL. Without the latter git never reads ~/.config/git/.gitconfig,
# the includeIf rules never apply, and commits are authored as user@hostname.
# ~/.local/bin is where `claude` lives and launchd would not find it otherwise.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export GIT_CONFIG_GLOBAL="${GIT_CONFIG_GLOBAL:-$HOME/.config/git/.gitconfig}"

stamp=$(date '+%Y-%m-%d %H:%M')
touched=0

# The vault's index.md is generated, and this script pushes within the hour. A
# stale index is worse than none -- it names notes that have moved or gone. Run
# it BEFORE the dirty check so a regenerated index is part of the same snapshot.
# launchd has no PATH additions, hence the absolute path.
if [[ -x "$HOME/.config/scripts/vault-index" ]]; then
	"$HOME/.config/scripts/vault-index" >/dev/null 2>&1 ||
		printf '%s  %-14s vault-index failed (index may be stale)\n' "$stamp" "second-brain"
fi

for repo in "${REPOS[@]}"; do
	name=$(basename "$repo")

	[[ -d "$repo/.git" ]] || { printf '%s  %-14s skipped (not a repo)\n' "$stamp" "$name"; continue; }

	# Cheapest possible check, and the first thing done per repo: if the tree is
	# clean there is nothing to spend time on -- no add, no commit, no network.
	dirty=$(git -C "$repo" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
	[[ "$dirty" -eq 0 ]] && continue

	git -C "$repo" add -A
	git -C "$repo" commit --quiet -m "$(generate_message "$repo" "$dirty")"
	printf '%s  %-14s committed %s file(s)' "$stamp" "$name" "$dirty"
	touched=1

	if [[ $PUSH -eq 1 ]]; then
		# Best effort. Being offline must not turn into a failed job, and must
		# not stop the next repo being handled.
		if git -C "$repo" push --quiet origin HEAD 2>/dev/null; then
			printf ', pushed\n'
		else
			printf ', push failed (offline?)\n'
		fi
	else
		printf '\n'
	fi
done

[[ $touched -eq 0 ]] && printf '%s  nothing to commit\n' "$stamp"
exit 0
