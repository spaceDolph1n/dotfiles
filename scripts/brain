#!/usr/bin/env bash
#
# brain -- append-only capture into the second brain.
#
#   brain "Marco knows the payments service"    one-liner  -> log.md
#   brain -d "Dropped the queue" [why] [expected]  decision -> decisions.md
#   brain -d                                    decision, prompts for the title
#   brain --relink                              link past entries to newer notes
#
# Design notes:
#   * Append-only. Nothing is filed, named or categorised at capture time --
#     that decision is what kills capture habits.
#   * Every line carries a full ISO timestamp so `rg 2026-08-07` returns the
#     entry itself, not a header three rows above it. Month headers are added
#     on the first entry of each month purely for scanning by eye.
#   * Writes and exits. It does NOT touch git -- writing the file is what makes
#     the thought durable; committing is a separate decision and stays yours.
#     Auto-committing produced one commit per thought and made the vault's
#     history useless.
#
# Tasks do NOT belong here -- those go to Todoist. Code-local reminders belong
# in a TODO: comment next to the code.

set -euo pipefail

VAULT="${BRAIN_VAULT:-$HOME/.sb/second-brain}"
LOG="$VAULT/log.md"
DECISIONS="$VAULT/decisions.md"
EDITOR_CMD="${EDITOR:-nvim}"

die() {
	printf 'brain: %s\n' "$1" >&2
	exit 1
}

usage() {
	sed -n '3,12p' "$0" | sed 's/^# \{0,1\}//'
	exit 0
}

[[ -d "$VAULT" ]] || die "vault not found: $VAULT"

# --- file / header scaffolding ----------------------------------------------

ensure_file() {
	local file="$1" title="$2"
	[[ -f "$file" ]] || printf '# %s\n' "$title" >"$file"
}

# Add a `## YYYY-MM` heading the first time we write in a given month.
ensure_month_header() {
	local file="$1" month
	month=$(date +%Y-%m)
	grep -qxF "## $month" "$file" || printf '\n## %s\n' "$month" >>"$file"
}


# --- editor -----------------------------------------------------------------

open_editor() {
	local file="$1" line="$2"
	if [[ -t 0 && -t 1 ]]; then
		"$EDITOR_CMD" "+$line" "$file"
	elif command -v wezterm >/dev/null 2>&1; then
		# Raycast runs scripts without a TTY, so spawn a real terminal.
		wezterm start --always-new-process -- "$EDITOR_CMD" "+$line" "$file" >/dev/null 2>&1 &
	else
		open -a WezTerm >/dev/null 2>&1 || die "no TTY and no wezterm to open $file"
	fi
}

# --- entry points -----------------------------------------------------------

# Turn concept names into [[wikilinks]] automatically.
#
# `work/` IS in scope, deliberately. Those notes are local-only and never pushed,
# so a [[link]] to one in the committed log.md resolves for me and is a dead link
# for anyone else -- it carries a filename and nothing more. Work entries in the
# stream are my own takes with confidential detail stripped, so the filename is
# not worth protecting.
#
# Do not "fix" this by excluding work/: the links are the point. If a genuinely
# confidential name ever needs to stay out, rename the note rather than changing
# the walk.
#
# This exists because capture happens from Raycast, where you cannot be
# expected to recall exact note filenames. Matching is on filenames only --
# free-form aliases produce wrong targets (a CI "pipeline" resolving to
# nodejs-pipe-vs-pipeline). Hyphens in a filename also match spaces, so
# "performance testing" finds performance-testing.
# Shared linking logic. ONE copy on purpose: the capture path and --relink used
# to carry separate copies of this regex and drifted, which is how `code-review`
# ended up linked inside `pr-review-toolkit:code-review`.
read -r -d '' BRAIN_LINK_PY <<'PY' || true
import os, re, sys

# Immediately adjacent characters that mean the hit is part of a larger
# identifier rather than prose. A space before or after is prose; these are not.
JOIN_BEFORE = ":/.@_-"
JOIN_AFTER = ":/@_-"


def stems(vault):
    out = []
    for root, dirs, files in os.walk(vault):
        dirs[:] = [d for d in dirs if d not in (".obsidian", ".git", "files")]
        for f in files:
            if f.endswith(".md") and f not in ("log.md", "decisions.md"):
                s = f[:-3]
                if "-" in s or len(s) >= 8:
                    out.append(s)
    out.sort(key=len, reverse=True)
    return out


def protected(text):
    """Ranges that must never be rewritten -- code, existing links, URLs."""
    spans = []
    for pat in (r"```.*?```", r"`[^`\n]*`", r"\[\[[^\]]*\]\]", r"\]\([^)]*\)",
                r"\bhttps?://\S+"):
        for m in re.finditer(pat, text, re.S):
            spans.append(m.span())
    return spans


def blocked(text, start, end, spans):
    if any(a <= start < b or a < end <= b for a, b in spans):
        return True
    if start > 0 and text[start - 1] in JOIN_BEFORE:
        return True
    if end < len(text) and text[end] in JOIN_AFTER:
        return True
    return False


def link_text(text, st, limit=3):
    linked = {x.lower() for x in re.findall(r"\[\[([^\]|#]+)", text)}
    added = 0
    for s in st:
        if added >= limit:
            break
        if s.lower() in linked:
            continue
        pat = r"\b" + re.escape(s).replace(r"\-", r"[-\s]") + r"\b"
        spans = protected(text)  # recomputed per stem: offsets shift on each edit
        for m in re.finditer(pat, text, re.I):
            if blocked(text, m.start(), m.end(), spans):
                continue
            hit = m.group(0)
            rep = "[[%s]]" % hit if hit.lower() == s.lower() else "[[%s|%s]]" % (s, hit)
            text = text[:m.start()] + rep + text[m.end():]
            linked.add(s.lower())
            added += 1
            break
    return text


mode = sys.argv[1]
if mode == "--text":
    st = stems(sys.argv[2])
    sys.stdout.write(link_text(sys.stdin.read(), st))
elif mode == "--stream":
    path, vault = sys.argv[2], sys.argv[3]
    st = stems(vault)
    out = []
    for line in open(path, encoding="utf-8"):
        if not line.lstrip().startswith(("- ", "### ")):
            out.append(line)
            continue
        out.append(link_text(line, st))
    open(path, "w", encoding="utf-8").write("".join(out))
else:
    sys.exit("brain_link: unknown mode %s" % mode)
PY

autolink() {
	python3 -c "$BRAIN_LINK_PY" --text "$VAULT"
}

# Notes get written after the entries that mention them -- you log something
# about Smallpdf on Monday and create the note on Friday. Without this, the
# Monday entry never points at it. Re-runs autolink over every existing entry;
# already-linked text is skipped, so it is safe to run repeatedly.
relink() {
	local before after
	for f in "$LOG" "$DECISIONS"; do
		[[ -f "$f" ]] || continue
		before=$(grep -c '\[\[' "$f" || true)
		python3 -c "$BRAIN_LINK_PY" --stream "$f" "$VAULT"
		after=$(grep -c '\[\[' "$f" || true)
		printf '%s: %s -> %s linked lines\n' "$(basename "$f")" "$before" "$after"
	done
	refresh_backlinks
}

# Write the stream entries that mention a note *into* that note, under a
# `## Backlinks` heading.
#
# Opt-in: only notes that already contain the heading are touched, so this
# never adds churn to the other hundred. `:Obsidian backlinks` shows the same
# thing in a picker -- this is for the handful of notes (entities, hubs) where
# you want the history visible as text when you open them.
refresh_backlinks() {
	VAULT="$VAULT" python3 - <<'PY'
import os, re
vault = os.environ["VAULT"]
HEAD = "## Backlinks"
MARK = "<!-- maintained by `brain --relink` — edits below are overwritten -->"

# Only a heading on its own line counts. Matching the bare string anywhere let a
# note that *described* the feature -- "refreshes `## Backlinks` sections" -- be
# treated as opting in, and the rewrite ate the rest of that sentence.
HEAD_RE = re.compile(r"^" + re.escape(HEAD) + r"[ \t]*$", re.M)


def heading_at(text):
    """Offset of a real Backlinks heading, or None. Ignores fenced code."""
    fences = [m.span() for m in re.finditer(r"```.*?```", text, re.S)]
    for m in HEAD_RE.finditer(text):
        if any(a <= m.start() < b for a, b in fences):
            continue
        return m.start()
    return None

streams = {}
for name in ("log.md", "decisions.md"):
    p = os.path.join(vault, name)
    if os.path.exists(p):
        streams[name] = open(p, encoding="utf-8").read().split("\n")

targets = []
for root, dirs, files in os.walk(vault):
    dirs[:] = [d for d in dirs if d not in (".obsidian", ".git", "files")]
    for f in files:
        if not f.endswith(".md") or f in ("log.md", "decisions.md"): continue
        p = os.path.join(root, f)
        if heading_at(open(p, encoding="utf-8").read()) is not None:
            targets.append((f[:-3], p))

updated = 0
for stem, path in targets:
    hits = []
    link = re.compile(r"\[\[" + re.escape(stem) + r"(\||\]\])", re.I)
    for name, lines in streams.items():
        for ln in lines:
            if not link.search(ln): continue
            # strip the leading bullet and the self-link, keep the date
            m = re.match(r"^[-#\s]*(\d{4}-\d{2}-\d{2})[^—]*—\s*(.*)$", ln.strip())
            if m:
                date, text = m.group(1), m.group(2)
            else:
                date, text = "", ln.strip("# -")
            text = re.sub(r"\[\[" + re.escape(stem) + r"(?:\|([^\]]*))?\]\]",
                          lambda x: x.group(1) or stem, text, flags=re.I)
            hits.append(f"- {date} — {text}" if date else f"- {text}")
    body = "\n".join(hits) if hits else "_none yet_"

    t = open(path, encoding="utf-8").read()
    i = heading_at(t)
    if i is None:
        continue
    nxt = t.find("\n## ", i + len(HEAD))
    end = len(t) if nxt == -1 else nxt + 1
    new = f"{HEAD}\n\n{MARK}\n{body}\n"
    if t[i:end].rstrip() != new.rstrip():
        open(path, "w", encoding="utf-8").write(t[:i] + new + t[end:])
        updated += 1
print(f"backlink sections refreshed: {updated}/{len(targets)}")
PY
}

add_log() {
	local text="$1"
	[[ -n "${text// /}" ]] || die "nothing to capture"
	ensure_file "$LOG" "Log"
	ensure_month_header "$LOG"
	local linked
	linked=$(printf '%s' "$text" | autolink)
	printf -- '- %s — %s\n' "$(date '+%Y-%m-%d %H:%M')" "$linked" >>"$LOG"
	if [[ "$linked" != "$text" ]]; then
		printf 'captured (linked)\n'
	else
		printf 'captured\n'
	fi
}

# The heading IS the "what" -- a separate **what** field just restated it, so
# it is gone. Fields left blank are omitted rather than written as empty
# bullets: an entry that only warrants a `why` should look finished, not
# half-filled. Not every decision needs an `expected`.
add_decision() {
	local title="$1" why="${2:-}" expected="${3:-}"
	[[ -n "${title// /}" ]] || die "a decision needs a title"
	ensure_file "$DECISIONS" "Decisions"
	ensure_month_header "$DECISIONS"

	local linked_title
	linked_title=$(printf '%s' "$title" | autolink)

	{
		printf '\n### %s — %s\n' "$(date '+%Y-%m-%d')" "$linked_title"
		if [[ -n "${why// /}" || -n "${expected// /}" ]]; then
			[[ -n "${why// /}" ]] && printf -- '- **why** %s\n' "$(printf '%s' "$why" | autolink)"
			[[ -n "${expected// /}" ]] && printf -- '- **expected** %s\n' "$(printf '%s' "$expected" | autolink)"
		else
			# Nothing supplied -- lay out the scaffold and let the editor fill it.
			printf -- '- **why**\n- **expected**\n- **instead**\n- **tags**\n'
		fi
	} >>"$DECISIONS"


	# A decision captured complete from Raycast needs no editor at all.
	if [[ -n "${why// /}" || -n "${expected// /}" ]]; then
		printf 'decision captured\n'
	else
		open_editor "$DECISIONS" "$(($(wc -l <"$DECISIONS") - 3))"
	fi
}

# --- args -------------------------------------------------------------------

case "${1:-}" in
-h | --help | "") usage ;;
-r | --relink)
	# Re-scan the log and decisions for concepts that have a note NOW but did
	# not when the entry was written. Notes get created after the fact, so
	# without this a past entry never points at the note it is about.
	relink
	;;
-d | --decision)
	shift
	# Positional: title, why, expected. Everything after the title is optional,
	# which is what lets Raycast pass all three and skip the editor entirely.
	title="${1:-}"
	why="${2:-}"
	expected="${3:-}"
	if [[ -z "$title" && -t 0 ]]; then
		read -r -p "decision: " title
	fi
	add_decision "$title" "$why" "$expected"
	;;
*) add_log "$*" ;;
esac
