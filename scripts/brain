#!/usr/bin/env bash
# One-line capture into the vault inbox, captures.md (never committed). /triage empties it.
#   brain "check nvim marks"     brain with no args prompts (or reads a piped line)
set -euo pipefail

VAULT="${BRAIN_VAULT:-$HOME/.sb/second-brain}"
INBOX="$VAULT/captures.md"

case "${1:-}" in
-h | --help) sed -n '2,3p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
-*) echo "brain: no options any more (decisions live in their note; see /capture)" >&2; exit 1 ;;
esac

if [ "$#" -gt 0 ]; then
	text="$*"
elif [ -t 0 ] && command -v fzf >/dev/null; then
	# fzf as a one-line input: Enter captures, Esc or Ctrl-C cancels (so the tmux popup closes).
	text="$(fzf --print-query --prompt 'capture › ' --no-info --layout=reverse --border=none --no-separator --no-scrollbar </dev/null | head -1)" || true
	[ -n "$text" ] || exit 0
elif [ -t 0 ]; then
	read -r -p "capture: " text
else
	IFS= read -r text || true
fi

text="$(printf '%s' "${text:-}" | tr -s '[:space:]' ' ' | sed 's/^ //; s/ $//')"
[ -n "$text" ] || { echo "brain: nothing to capture" >&2; exit 1; }

line="- $(date '+%Y-%m-%d %H:%M') — $text"
# Same lock as vault-triage, so a removal never races this append.
lockf -k -t 5 "$VAULT/.captures.lock" sh -c 'printf "%s\n" "$1" >>"$2"' _ "$line" "$INBOX"
echo "captured"
