# Generated by `scripts/theme` -- edit tmux/theme.conf.tmpl, not this.
#
# status-justify, status-{left,right}-length, window-status-{style,separator} and
# clock-mode-colour were set only by the catppuccin plugin. Delete one and the
# next fresh server regresses.
#
# `window-status-activity-style` is deliberately NOT set: tmux's `reverse` default
# is an attribute, so unlike a colour it survives the format's explicit fg.
#
# Glyphs go in as escapes in the generator -- a literal gets stripped in transit.

# --- surfaces ----------------------------------------------------------------

set -g status-style        'bg=<<ui.bg>>,fg=<<ui.fg>>,fill=<<ui.bg>>'

# The default status-format resets to the status default style three times, and
# `fill=` does not survive that. These two are what the template applies to its
# aligned regions, so the padding between the window list and the right side
# takes its background from here.
set -g status-left-style   'bg=<<ui.bg>>,fg=<<ui.fg>>'
set -g status-right-style  'bg=<<ui.bg>>,fg=<<ui.fg>>'

# tmux.conf blanks status row [1] for breathing room and needs this colour
# to fill it; a user option keeps that file theme-agnostic.
set -g @theme_bg           '<<ui.bg>>'
set -g status-justify      left
set -g status-left-length  100
set -g status-right-length 100

# Only cells using the terminal's default background take the tint, so a TUI that
# paints its own stays undimmed -- nvim is exempt via `transparent = true`, but
# lazygit, btop and yazi are not.
set -g window-style        'bg=<<ui.bg_inactive>>'
set -g window-active-style 'bg=<<ui.bg>>'

set -g pane-active-border-style 'fg=<<syn.type>>,bg=default'
set -g pane-border-style        'fg=<<ui.bg_p2>>,bg=default'

# `fill=` is REQUIRED as of tmux 3.7; `bg=` alone renders the prompt as a box that
# grows as you type. That is what broke on the 3.7 upgrade.
set -g message-style         'fg=<<ui.bg>>,bg=<<syn.type>>,align=left,fill=<<syn.type>>'
set -g message-command-style 'fg=<<ui.fg>>,bg=<<ui.bg_p2>>,align=left,fill=<<ui.bg_p2>>'

set -g clock-mode-colour '<<syn.type>>'

# --- status line -------------------------------------------------------------

set -g status-left "#[fg=#{?client_prefix,<<term.9>>,<<syn.type>>},bg=<<ui.bg>>]  #[fg=<<ui.fg>>]#S  "

set -g status-right "#[fg=<<syn.type>>,bg=<<ui.bg>>] #[fg=<<ui.fg_dim>>]#{b:pane_current_path}   #[fg=<<syn.type>>]󰃰 #[fg=<<ui.fg_dim>>]%H:%M "

# --- windows -----------------------------------------------------------------
#
# `@workmux_status` is prefixed here rather than left to workmux's own
# `status_format`, which appends it after the number and pins a stale copy of this
# format per window. Expands to nothing when unset.
#
# `ui.fg_dim` for the inactive name was tried and rejected: 1.45:1 against the
# active name in kanso, 1.10:1 in dragon. `ui.nontext` gives 3.78:1 and 3.84:1.
set -g window-status-format " #[fg=<<ui.nontext>>]#I #{?@workmux_status,#{@workmux_status},}#[fg=<<ui.nontext>>]#W  "

set -g window-status-current-format " #[fg=<<ui.nontext>>]#I #{?@workmux_status,#{@workmux_status},}#[fg=<<ui.fg>>]#W#{?window_zoomed_flag,(),}  "

set -g window-status-style          'fg=<<ui.nontext>>,bg=<<ui.bg>>,none'
set -g window-status-separator      ''
