[user]
    name = spaceDolph1n
    email = tiagojsr1@gmail.com

[core]
    sshCommand = ssh -i ~/.ssh/id_ed25519_personal -o IdentitiesOnly=yes

[pull]
    rebase = true

[push]
    # Automatically sets upstream branch on first push
    autoSetupRemote = true

[fetch]
    prune = true

[merge]
  conflictstyle = zdiff3   # shows the common ancestor; strictly better than diff3

[init]
    defaultBranch = main

[rebase]
	autoStash = true

# This rewrite applies only where the includeIf rules load this file — ~/.claude,
# ~/.sb, ~/.config/dotfiles — so work repos are untouched.
[url "git@github-personal:"]
    insteadOf = git@github.com:
