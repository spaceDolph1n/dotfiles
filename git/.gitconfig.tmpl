# ---------------------------------------------------------------------------
# Diff rendering
# ---------------------------------------------------------------------------
# hunk is the pager: `hunk pager` detects diffs and passes everything else
# through, which is what diffnav could never do. diffnav wraps delta with a
# GitHub-style file tree and is what gh-dash and `git dn` use -- a full TUI
# and is wrong for piping into other commands.
[core]
  pager = hunk pager

[interactive]
  diffFilter = delta --color-only

# delta stays for the two jobs a TUI cannot do -- `interactive.diffFilter` above
# and lazygit's inline renderer both need coloured text on stdout. Its colours are
# generated, which also themes diffnav, since diffnav shells out to delta.
[delta]
  navigate = true          # n / N to jump between files
  line-numbers = true
  side-by-side = false     # unified reads better at split-pane widths
  hyperlinks = true
  plus-style = "syntax <<diff.add>>"
  minus-style = "syntax <<diff.delete>>"
  plus-emph-style = "syntax <<diff.add_content>>"
  minus-emph-style = "syntax <<diff.delete_content>>"
  hunk-header-decoration-style = "<<ui.bg_p2>>"
  line-numbers-zero-style = "<<ui.nontext>>"

[alias]
  # diffnav is diff-only and full-screen, so it cannot be `core.pager` -- that
  # also handles log/show/blame. These give the file-tree view on demand.
  # Both take normal git-diff args:  git dn HEAD~3   git dn main...HEAD
  dn = "!f() { git --no-pager diff \"$@\" | diffnav; }; f"
  dnc = "!f() { git --no-pager diff --cached \"$@\" | diffnav; }; f"
  dns = "!f() { git --no-pager show \"$@\" | diffnav; }; f"

[diff]
  colorMoved = default     # distinguishes moved code from added/removed

[includeIf "gitdir:~/.config/dotfiles/"]
  path = ~/.config/git/.gitconfig-personal

[includeIf "gitdir:~/.sb/"]
  path = ~/.config/git/.gitconfig-personal

[includeIf "gitdir:~/.claude/"]
  path = ~/.config/git/.gitconfig-personal

[includeIf "gitdir:~/Documents/playground/"]
  path = ~/.config/git/.gitconfig-personal

[includeIf "gitdir:~/Documents/work/"]
  path = ~/.config/git/.gitconfig-work

