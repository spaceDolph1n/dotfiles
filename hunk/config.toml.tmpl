# hunk -- review-first diff viewer. Stowed to ~/.config/hunk/config.toml, which
# is the path hunk looks for ($XDG_CONFIG_HOME/hunk, else ~/.config/hunk).
#
# Bound to `prefix + D` in tmux, which opens `hunk diff --watch` on the current
# pane's tree. Review keys worth remembering: `,`/`.` file, `[`/`]` hunk,
# `{`/`}` annotated hunk, `c` leave a note, `a` toggle agent notes, `e` open the
# selected file in $EDITOR, `t` theme picker, `?` everything else.

theme = "<<theme>>"

# `[themes.<id>]` rather than `[custom_theme]`: same keys, but it takes a name,
# shows up in the `t` picker, and leaves room for a second theme later.
#
# View preferences below this line are written by hunk itself when you accept its
# "save view changes?" prompt on quit. It edits this file in place, and the file
# is a symlink into the dotfiles repo -- so answering yes commits a diff.
mode = "split"
line_numbers = true
wrap_lines = true
hunk_headers = false
menu_bar = true
agent_notes = true
copy_decorations = false
cursor_line = "row"

# Base is kanagawa-wave, not kanagawa-dragon: kanso is a kanagawa derivative
# either way, but dragon IS the desaturated variant, and layering kanso's own
# muted palette over it produced grey soup. Wave carries the colour; the
# overrides below pull it toward kanso.
#
# Values are lifted from kanso.nvim's own palette (lua/kanso/colors.lua) and its
# zen theme mapping (lua/kanso/themes.lua), so hunk, nvim, tmux and wezterm are
# all reading the same numbers.
[themes.kanso]
base = "kanagawa-wave"
label = "Kanso Zen"

# Surfaces: `background` is the same colour tmux paints for the active pane, so a
# zoomed hunk pane is continuous with the terminal behind it.
background = "<<kanso:ui.bg>>" # the darkest surface
panel = "<<kanso:ui.bg>>"      # the diff surface too, not just the sidebar
panelAlt = "<<kanso:ui.bg_p2>>"   # two steps up
border = "<<kanso:ui.border>>"     # panel borders
accent = "<<kanso:syn.type>>"     # the aqua tmux uses for the active pane border
accentMuted = "<<kanso:ui.nontext>>" # dimmest text
text = "<<kanso:ui.fg>>"       # body text
# A step dimmer than the comment grey, deliberately. hunk spends `muted` on the
# file sidebar, so with the two equal, twenty unselected filenames sat in the
# exact grey of every comment beside them. Measured: 843 chars of comment-grey on
# one screen, most of it the file list.
muted = "<<kanso:ui.nontext>>"

# Row tints are kanso's own diff palette. `moved` has no kanso equivalent, so it
# borrows the change/text tints -- moved code is neither an add nor a delete.
addedBg = "<<kanso:diff.add>>"        # added row tint
removedBg = "<<kanso:diff.delete>>"      # removed row tint
movedAddedBg = "<<kanso:diff.change>>"   # moved-added tint
movedRemovedBg = "<<kanso:diff.text>>" # moved-removed tint
contextBg = "<<kanso:ui.bg>>"
contextContentBg = "<<kanso:ui.bg>>"

# Word-level highlights have to read as louder than the row tint they sit in.
# kanso ships no such pair, so these are its row tint lifted a third of the way
# toward its git sign colour; `scripts/theme-palette` computes both.
addedContentBg = "<<kanso:diff.add_content>>"
removedContentBg = "<<kanso:diff.delete_content>>"

addedSignColor = "<<kanso:vcs.added>>"   # added sign
removedSignColor = "<<kanso:vcs.removed>>" # removed sign

lineNumberBg = "<<kanso:ui.bg>>"
lineNumberFg = "<<kanso:ui.nontext>>" # dimmest text
selectedHunk = "<<kanso:ui.bg_p2>>" # two steps up, the cursor_line row

badgeAdded = "<<kanso:vcs.added>>"
badgeRemoved = "<<kanso:vcs.removed>>"
badgeNeutral = "<<kanso:syn.punct>>" # neutral badge

# File states reuse the git colours tmux and lazygit already use, so a modified
# file is the same amber in every tool.
fileNew = "<<kanso:vcs.added>>"
fileDeleted = "<<kanso:vcs.removed>>"
fileRenamed = "<<kanso:term.12>>"   # renamed
fileModified = "<<kanso:vcs.changed>>"  # modified
fileUntracked = "<<kanso:vcs.untracked>>" # untracked

# Notes are violet -- the one hue kanso does not spend on diff or git state, so
# a note never reads as a change.
noteBorder = "<<kanso:note.border>>"          # violet -- not a diff or git hue
noteBackground = "<<kanso:note.bg>>"
noteTitleBackground = "<<kanso:note.title_bg>>"
noteTitleText = "<<kanso:ui.fg>>"

# Exact Shiki/TextMate scopes, mapped from kanso's `syn` table.
#
# Only the scopes that carry kanso's character are listed. The first version of
# this file also set `variable`, `punctuation`, `keyword.operator` and
# `variable.parameter` to two greys, faithfully copying kanso.nvim -- and those
# four scopes cover most of the tokens on a screen, so the whole diff read as
# light grey. They are gone: the base paints them now, and the colour below
# lands on the words that actually distinguish one thing from another.
[themes.kanso.syntax_scopes]
"comment" = "<<kanso:syn.comment>>"
"punctuation.definition.comment" = "<<kanso:syn.comment>>"
"string" = "<<kanso:syn.string>>"
"string.quoted" = "<<kanso:syn.string>>"
"string.template" = "<<kanso:syn.string>>"
"string.regexp" = "<<kanso:syn.regex>>"
"constant.numeric" = "<<kanso:syn.number>>"
"constant.language" = "<<kanso:syn.constant>>"
"constant.character" = "<<kanso:syn.constant>>"
"keyword" = "<<kanso:syn.keyword>>"
"keyword.control" = "<<kanso:syn.keyword>>"
"storage.type" = "<<kanso:syn.keyword>>"
"storage.modifier" = "<<kanso:syn.keyword>>"
"entity.name.function" = "<<kanso:syn.fun>>"
"support.function" = "<<kanso:syn.fun>>"
"entity.name.type" = "<<kanso:syn.type>>"
"support.type" = "<<kanso:syn.type>>"
"support.class" = "<<kanso:syn.type>>"

# `nextAnnotatedFile` / `previousAnnotatedFile` ship with no keys at all, and
# "jump to the next file carrying a note" is the whole review loop once notes are
# in play. `<` and `>` are the shifted `,`/`.` that move between plain files --
# the same relationship `{`/`}` have to `[`/`]`. Both were free.
[themes.kanagawa-dragon]
# Same roles as above; see the kanso block for the reasoning.
base = "kanagawa-dragon"
label = "Kanagawa Dragon"

background = "<<kanagawa-dragon:ui.bg>>" # the darkest surface
panel = "<<kanagawa-dragon:ui.bg>>"      # the diff surface too, not just the sidebar
panelAlt = "<<kanagawa-dragon:ui.bg_p2>>"   # two steps up
border = "<<kanagawa-dragon:ui.border>>"     # panel borders
accent = "<<kanagawa-dragon:syn.type>>"     # the aqua tmux uses for the active pane border
accentMuted = "<<kanagawa-dragon:ui.nontext>>" # dimmest text
text = "<<kanagawa-dragon:ui.fg>>"       # body text
muted = "<<kanagawa-dragon:ui.nontext>>"

addedBg = "<<kanagawa-dragon:diff.add>>"        # added row tint
removedBg = "<<kanagawa-dragon:diff.delete>>"      # removed row tint
movedAddedBg = "<<kanagawa-dragon:diff.change>>"   # moved-added tint
movedRemovedBg = "<<kanagawa-dragon:diff.text>>" # moved-removed tint
contextBg = "<<kanagawa-dragon:ui.bg>>"
contextContentBg = "<<kanagawa-dragon:ui.bg>>"

addedContentBg = "<<kanagawa-dragon:diff.add_content>>"
removedContentBg = "<<kanagawa-dragon:diff.delete_content>>"

addedSignColor = "<<kanagawa-dragon:vcs.added>>"   # added sign
removedSignColor = "<<kanagawa-dragon:vcs.removed>>" # removed sign

lineNumberBg = "<<kanagawa-dragon:ui.bg>>"
lineNumberFg = "<<kanagawa-dragon:ui.nontext>>" # dimmest text
selectedHunk = "<<kanagawa-dragon:ui.bg_p2>>" # two steps up, the cursor_line row

badgeAdded = "<<kanagawa-dragon:vcs.added>>"
badgeRemoved = "<<kanagawa-dragon:vcs.removed>>"
badgeNeutral = "<<kanagawa-dragon:syn.punct>>" # neutral badge

fileNew = "<<kanagawa-dragon:vcs.added>>"
fileDeleted = "<<kanagawa-dragon:vcs.removed>>"
fileRenamed = "<<kanagawa-dragon:term.12>>"   # renamed
fileModified = "<<kanagawa-dragon:vcs.changed>>"  # modified
fileUntracked = "<<kanagawa-dragon:vcs.untracked>>" # untracked

noteBorder = "<<kanagawa-dragon:note.border>>"          # violet -- not a diff or git hue
noteBackground = "<<kanagawa-dragon:note.bg>>"
noteTitleBackground = "<<kanagawa-dragon:note.title_bg>>"
noteTitleText = "<<kanagawa-dragon:ui.fg>>"

[themes.kanagawa-dragon.syntax_scopes]
"comment" = "<<kanagawa-dragon:syn.comment>>"
"punctuation.definition.comment" = "<<kanagawa-dragon:syn.comment>>"
"string" = "<<kanagawa-dragon:syn.string>>"
"string.quoted" = "<<kanagawa-dragon:syn.string>>"
"string.template" = "<<kanagawa-dragon:syn.string>>"
"string.regexp" = "<<kanagawa-dragon:syn.regex>>"
"constant.numeric" = "<<kanagawa-dragon:syn.number>>"
"constant.language" = "<<kanagawa-dragon:syn.constant>>"
"constant.character" = "<<kanagawa-dragon:syn.constant>>"
"keyword" = "<<kanagawa-dragon:syn.keyword>>"
"keyword.control" = "<<kanagawa-dragon:syn.keyword>>"
"storage.type" = "<<kanagawa-dragon:syn.keyword>>"
"storage.modifier" = "<<kanagawa-dragon:syn.keyword>>"
"entity.name.function" = "<<kanagawa-dragon:syn.fun>>"
"support.function" = "<<kanagawa-dragon:syn.fun>>"
"entity.name.type" = "<<kanagawa-dragon:syn.type>>"
"support.type" = "<<kanagawa-dragon:syn.type>>"
"support.class" = "<<kanagawa-dragon:syn.type>>"

[keybindings]
"hunk.review.nextAnnotatedFile" = ">"
"hunk.review.previousAnnotatedFile" = "<"
