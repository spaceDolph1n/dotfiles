# NOTE: git does not support trailing comments on a pattern line. Every rule in
# the previous version of this file was written as `.DS_Store  # macOS metadata`
# and therefore matched a literal filename with spaces and a hash in it -- i.e.
# nothing. That is how .DS_Store and a stray tmux log ended up committed.

# macOS / editor cruft
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
*.swp
*.swo
*~
*.bak

# Logs and temp files
*.log
.cache/
.tmp/
temp/

# Secrets
.env
.env.*
.secret
*.key
*.pem
id_rsa
id_ed25519
id_ecdsa
# Signature allow-list is generated per machine from ~/.ssh
allowed_signers

# Tooling
node_modules/
__pycache__/
*.pyc
.idea/
.vscode/

# Local, machine-specific overrides
local/
local.*
*.local

# tmux plugin manager checkouts
/tmux/plugins/
