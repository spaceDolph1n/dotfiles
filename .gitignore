# NOTE: git does not support trailing comments on a pattern line. Every rule in
# the previous version of this file was written as `.DS_Store  # macOS metadata`
# and therefore matched a literal filename with spaces and a hash in it -- i.e.
# nothing. That is how .DS_Store and a stray tmux log ended up committed.

# macOS / editor cruft
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
*.swp
*.swo
*~
*.bak

# Logs and temp files
*.log
.cache/
.tmp/
temp/

# Secrets
.env
.env.*
.secret
*.key
*.pem
id_rsa
id_ed25519
id_ecdsa
# Signature allow-list is generated per machine from ~/.ssh
allowed_signers

# Tooling
# Playwright MCP dumps page snapshots and console logs into whatever directory
# it was launched from, which is usually this one. They are scratch output of a
# browsing session -- often of some *other* project's site -- and have no
# business in a dotfiles repo, let alone a public one.
.playwright-mcp/
node_modules/
__pycache__/
*.pyc
.idea/
.vscode/

# gh-dash: its config is a list of employer repo names, local work paths and
# team review filters. This repo is public, so that config is the one file here
# that cannot be in it. ~/.config/gh-dash still symlinks to gh-dash/, so the
# tool works exactly as before -- the file is simply unversioned, and has to be
# rewritten by hand on a new machine.
/gh-dash

# Local, machine-specific overrides
local/
local.*
*.local

# tmux plugin manager checkouts
/tmux/plugins

# Holds only machine-local Claude settings, already covered by the global
# ~/.config/git/ignore. Named here so the pattern matches the *symlink* workmux
# creates in each worktree, which the global rule cannot see into.
/.claude
