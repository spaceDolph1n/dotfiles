+    fn row_bg(app: &mut SidebarApp, needle: &str) -> ratatui::style::Color {
+        let mut terminal = Terminal::new(TestBackend::new(34, 24)).unwrap();
+        terminal.draw(|f| render_sidebar(f, app)).unwrap();
+        let buffer = terminal.backend().buffer();
+        let y = (0..24)
+            .find(|y| buffer_row(buffer, *y).contains(needle))
+            .unwrap_or_else(|| panic!("{needle} is drawn"));
+        buffer[(4, y)].bg
+    }
+
+    #[test]
+    fn the_host_row_is_marked_and_the_cursor_hides_while_unfocused() {
+        for mode in [SidebarLayoutMode::Tiles, SidebarLayoutMode::Compact] {
+            let mut app = tile_app();
+            app.layout_mode = mode;
+            app.sidebar_focused = false;
+
+            assert_eq!(
+                row_bg(&mut app, "sidebar-groups"),
+                app.palette.current_row_bg,
+                "{mode:?}"
+            );
+            assert_eq!(row_bg(&mut app, "auth-refresh"), Color::Reset, "{mode:?}");
+        }
+    }
+
+    #[test]
+    fn a_focused_sidebar_shows_the_cursor_beside_the_host_row() {
+        for mode in [SidebarLayoutMode::Tiles, SidebarLayoutMode::Compact] {
+            let mut app = tile_app();
+            app.layout_mode = mode;
+            app.sidebar_focused = true;
+
+            assert_eq!(
+                row_bg(&mut app, "sidebar-groups"),
+                app.palette.current_row_bg,
+                "{mode:?}"
+            );
+            assert_eq!(
+                row_bg(&mut app, "auth-refresh"),
+                app.palette.highlight_row_bg,
+                "{mode:?}"
+            );
+        }
+    }
+
+    #[test]
+    fn a_stale_host_keeps_its_bold_name() {
+        let mut app = tile_app();
+        app.dim_stale = true;
+        app.agents[5].status = None;
+        app.refresh_stale_pane_ids();
+        app.rebuild_rows();
+
+        let mut terminal = Terminal::new(TestBackend::new(34, 24)).unwrap();
+        terminal.draw(|f| render_sidebar(f, &mut app)).unwrap();
+        let buffer = terminal.backend().buffer();
+        let y = (0..24)
+            .find(|y| buffer_row(buffer, *y).contains("sidebar-groups"))
+            .expect("host is drawn");
+        let row = buffer_row(buffer, y);
+        let x = row[..row.find("sidebar-groups").unwrap()].chars().count() as u16;
+        assert!(buffer[(x, y)].modifier.contains(Modifier::BOLD));
+    }
+
