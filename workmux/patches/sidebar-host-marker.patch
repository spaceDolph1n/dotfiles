         // Track whether the host window and its sidebar pane are active.
+        let was_host_window_active = self.host_window_active;
         self.host_window_active = if let Some(identity) = &self.host_identity {
             snapshot
                 .active_windows
@@ -584,9 +589,13 @@ impl SidebarApp {
 
         // Manual selection belongs to direct sidebar interaction. When an agent
         // pane has focus, the selection follows the agent in the host window.
-        if self.host_window_active && host_sidebar_active == Some(false) {
+        // Entering the window resets it too, since focus may land on the sidebar itself.
+        if self.host_window_active
+            && (host_sidebar_active == Some(false) || !was_host_window_active)
+        {
             self.selection_mode = SelectionMode::FollowHost;
         }
+        self.sidebar_focused = self.host_window_active && host_sidebar_active != Some(false);
 
         // Preserve selection by pane_id, or by group when it rests on a toggle
         let selected_pane = self
@@ -769,6 +778,11 @@ impl SidebarApp {
             .map(|identity| identity.session_name.as_str())
     }
 
+    /// Whether the visible cursor sits on this row; it hides while the sidebar is unfocused.
+    pub fn cursor_on(&self, row_idx: usize) -> bool {
+        self.sidebar_focused && self.list_state.selected() == Some(row_idx)
+    }
+
     pub fn host_window_active(&self) -> bool {
         self.host_window_active
     }
@@ -2305,6 +2319,36 @@ mod tests {
         assert_eq!(app.selection_mode, SelectionMode::FollowHost);
     }
 
+    #[test]
+    fn entering_the_host_window_drops_a_manual_selection() {
+        let mut app = selection_app();
+        app.select_index(1);
+        let mut away = selection_snapshot(&["%sidebar"]);
+        away.active_windows = std::collections::HashSet::from([("s".into(), "@other".into())]);
+        app.apply_snapshot(away);
+        assert_eq!(app.selection_mode, SelectionMode::Manual);
+
+        // Coming back lands focus on the sidebar pane, which used to keep the old cursor.
+        app.apply_snapshot(selection_snapshot(&["%sidebar"]));
+
+        assert_eq!(app.list_state.selected(), Some(0));
+        assert_eq!(app.selection_mode, SelectionMode::FollowHost);
+    }
+
+    #[test]
+    fn sidebar_focus_follows_the_host_sidebar_pane() {
+        let mut app = selection_app();
+        assert!(!app.sidebar_focused);
+
+        app.apply_snapshot(selection_snapshot(&["%sidebar"]));
+        assert!(app.sidebar_focused);
+
+        let mut away = selection_snapshot(&["%sidebar"]);
+        away.active_windows = std::collections::HashSet::from([("s".into(), "@other".into())]);
+        app.apply_snapshot(away);
+        assert!(!app.sidebar_focused);
+    }
+
     #[test]
     fn active_sidebar_pane_preserves_manual_selection() {
         let mut app = selection_app();
diff --git a/src/command/sidebar/template/context.rs b/src/command/sidebar/template/context.rs
