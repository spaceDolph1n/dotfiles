         )
     }
 
+    /// Background for the whole row: the cursor wins, then the host ("where I am") row.
+    pub fn row_bg(&self) -> Option<Color> {
+        if self.is_selected {
+            Some(self.palette.highlight_row_bg)
+        } else if self.is_active {
+            Some(self.palette.current_row_bg)
+        } else {
+            None
+        }
+    }
+
     /// Intrinsic style for a token (before state/selection post-pass).
     pub fn intrinsic_style(&self, token: TokenId) -> Style {
-        if self.is_stale {
+        if self.is_stale && !(self.is_active && token == TokenId::Primary) {
             return Style::default()
                 .fg(self.palette.dimmed)
                 .add_modifier(Modifier::DIM);
