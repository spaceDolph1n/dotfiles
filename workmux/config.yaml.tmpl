# Global workmux defaults -- stowed to ~/.config/workmux/config.yaml.
# Per-repo overrides live in that repo's .workmux.yaml; project settings replace
# these entirely (except hook and file lists, which can opt in with "<global>").

# Keep every worktree under one root instead of scattering `<project>__worktrees`
# siblings next to each repo -- ~/.config in particular should not collect them.
worktree_dir: ~/.worktrees/{project}

# Branch names like `DEV-123/thing` become worktree dir `thing`, not `DEV-123-thing`.
worktree_naming: basename

agent: claude

# Append new worktree windows at the end. The default `after_current` inserts
# them mid-list, and with `renumber-windows on` that reshuffles the index of
# every window to the right -- which breaks navigating to tabs by number.
window_placement: rightmost

# No `wm-` on tmux window names. The worktree handle is already unique and the
# prefix only ate width in the status line; workmux finds its own windows by
# stored id, not by matching the name.
window_prefix: ""

# The shell is the first pane and the agent splits off it, which is what puts the
# agent on the right: `split: horizontal` is tmux's own -h, side-by-side, and the
# new pane lands to the right of the one it split. `vertical` would stack them.
# No `size` -- the units are cells, not percent, so a fixed column count would be
# wrong on every monitor except the one it was tuned on. Omitting it gives 50/50.
panes:
  - {} # left: no command, so the default shell
  - command: <agent>
    split: horizontal
    focus: true

# Colored dots instead of emoji: single-width, and painted from the same palette
# as the status line.
#
# The dot does NOT reset the foreground after itself. It used to, so that the
# window name following it would come back to catppuccin's pill colour -- but the
# pill is gone, and the reset made every window carrying a dot render its name in
# full fg, losing the dim/active distinction. tmux/theme.conf now sets the name
# colour after the dot instead.
# Half-filled and muted for `working` -- it is the common, non-actionable state,
# but a hollow ring had too little ink to spot. The two states worth reacting to
# are solid. Amber belongs to `done`: the current window is signalled by text
# strength rather than a colour, which leaves the accent free here.
# The dot renders *inside* catppuccin's window pill, so it restores the pill's
# foreground (<<term.15>>) rather than using #[default], which would also reset the
# background and strip the fill off inactive tabs. Trailing space separates it
# from the window name.
status_icons:
  working: "#[fg=<<syn.type>>]◐ "
  waiting: "#[fg=<<diag.error>>]● "
  done: "#[fg=<<vcs.changed>>]● "
  sleeping: "#[fg=<<ui.nontext>>]󰒲 "

# Do not let workmux rewrite window-status-format. Left on, it copies whatever
# catppuccin had rendered at that moment into a *per-window* override and appends
# the icon on the right -- freezing the theme and putting the dot after the number.
# tmux.conf owns the format instead and places `@workmux_status` before the name.
status_format: false
nerdfont: true

# Left, as a column rather than a bar. Across the top it stacked under the tab
# row and read as a second bar saying nearly the same thing; as a column it is a
# list I move through with j/k, which is the motion I already use everywhere.
#
# `width` is explicit because the default is "10%" clamped to 25-50 columns --
# taken out of every window. Explicit values skip the clamp (minimum 10), so 26
# buys the list back at a third of the cost.
#
# `layout` is deliberately NOT set: unset leaves the default (tiles) and keeps
# `v` free to toggle compact/tiles at runtime, which is how I compare them.
# Dashboard colours. `theme.custom` is the documented shape -- a flat colour map
# under `theme:` parses without complaint and does nothing, because workmux
# ignores a malformed theme silently. Field names are from the docs, not the
# binary, whose serde run is truncated: 15 fields, not the 11 it appears to hold.
#
# Without this workmux paints catppuccin: #cdd6f4 text, #6c7086 dim, #28303e row
# background -- which is what clashed with the status line.
#
# The mapping is the status line's own levels: `ui.fg` for the current row and
# `ui.nontext` for every other, which is 3.78:1 apart. `ui.fg_dim` was tried for
# the others and is only 1.45:1 from the current row -- the same too-close pair
# that failed on the tmux tabs. Stale rows take `dimmed` plus workmux's own dim
# attribute on top. Aqua for chrome, amber warning, green success, red danger.
theme:
  custom:
    current_row_bg: "<<ui.bg_p2>>"
    highlight_row_bg: "<<ui.bg_p1>>"
    current_worktree_fg: "<<ui.fg>>"
    text: "<<ui.nontext>>"
    dimmed: "<<ui.nontext>>"
    border: "<<ui.border>>"
    help_border: "<<ui.bg_p2>>"
    help_muted: "<<ui.nontext>>"
    header: "<<syn.type>>"
    keycap: "<<syn.type>>"
    info: "<<diag.info>>"
    success: "<<vcs.added>>"
    warning: "<<vcs.changed>>"
    danger: "<<diag.error>>"
    accent: "<<syn.type>>"

sidebar:
  position: left
  width: 26
