# Rendered by scripts/theme into `config`; edit this file, not that one.

foreground = #e0def4
background = #090b10
cursor-color = #e0def4
cursor-text = #090b10
selection-foreground = #e0def4
selection-background = #26233a
split-divider-color = #26233a

palette = 0=#26233a
palette = 1=#eb6f92
palette = 2=#31748f
palette = 3=#f6c177
palette = 4=#9ccfd8
palette = 5=#c4a7e7
palette = 6=#ebbcba
palette = 7=#e0def4
palette = 8=#6e6a86
palette = 9=#eb6f92
palette = 10=#31748f
palette = 11=#f6c177
palette = 12=#9ccfd8
palette = 13=#c4a7e7
palette = 14=#ebbcba
palette = 15=#e0def4

font-family = JetBrains Mono
font-size = 12.5
adjust-cell-height = 5%

macos-titlebar-style = hidden
background-opacity = 1

# Top is the gap above the tmux status bar. Values are points, not pixels.
window-padding-x = 8
window-padding-y = 12,4
window-padding-balance = false

cursor-invert-fg-bg = true

macos-option-as-alt = left
confirm-close-surface = false
auto-update = off
copy-on-select = clipboard

keybind = ctrl+apostrophe=clear_screen
# The defaults make these word jumps, which swallows tmux's prefix + M-Left/Right.
keybind = alt+arrow_left=unbind
keybind = alt+arrow_right=unbind
