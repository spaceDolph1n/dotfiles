# Rendered by scripts/theme into `config`; edit this file, not that one.

foreground = <<ui.fg>>
background = <<ui.bg>>
cursor-color = <<ui.fg>>
cursor-text = <<ui.bg>>
selection-foreground = <<ui.fg>>
selection-background = <<ui.bg_p2>>
split-divider-color = <<ui.bg_p2>>

palette = 0=<<term.0>>
palette = 1=<<term.1>>
palette = 2=<<term.2>>
palette = 3=<<term.3>>
palette = 4=<<term.4>>
palette = 5=<<term.5>>
palette = 6=<<term.6>>
palette = 7=<<term.7>>
palette = 8=<<term.8>>
palette = 9=<<term.9>>
palette = 10=<<term.10>>
palette = 11=<<term.11>>
palette = 12=<<term.12>>
palette = 13=<<term.13>>
palette = 14=<<term.14>>
palette = 15=<<term.15>>

font-family = JetBrains Mono
font-size = 12.5
adjust-cell-height = 5%

macos-titlebar-style = hidden
background-opacity = 1

# Top is the gap above the tmux status bar. Values are points, not pixels.
window-padding-x = 8
window-padding-y = 12,4
window-padding-balance = false

cursor-invert-fg-bg = true

macos-option-as-alt = left
confirm-close-surface = false
auto-update = off
copy-on-select = clipboard

keybind = ctrl+apostrophe=clear_screen
# The defaults make these word jumps, which swallows tmux's prefix + M-Left/Right.
keybind = alt+arrow_left=unbind
keybind = alt+arrow_right=unbind
